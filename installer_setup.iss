; Script generated by Inno Setup Script Wizard.
; Complete Standalone All-In-One Installer for PhantomManagement / OpsCore Pro

#define MyAppName "OpsCore Pro - Lottery Management System"
#define MyAppVersion "1.0.0"
#define MyAppPublisher "Radhe Radhe Enterprises"
#define MyAppExeName "opscore_pro.exe"

[Setup]
; NOTE: The value of AppId uniquely identifies this application.
AppId={{5E1698E0-9E11-477D-9D22-C89C579BE771}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
DefaultDirName={autopf}\OpsCore Pro
DefaultGroupName=OpsCore Pro
DisableProgramGroupPage=yes
OutputDir=build\installer
OutputBaseFilename=OpsCore_Pro_Windows_Setup_v1.0.0
SetupIconFile=windows\runner\resources\app_icon.ico
Compression=lzma2/ultra64
SolidCompression=yes
WizardStyle=modern
UninstallDisplayIcon={app}\opscore_pro.exe
ArchitecturesInstallIn64BitMode=x64compatible

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
; Main Flutter Windows Release Executables and Libraries
Source: "build\windows\x64\runner\Release\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

; 🚀 ALL-IN-ONE STANDALONE VC++ RUNTIME DLLs (Embeds directly so no MSVCP140.dll error on any Windows 10/11 PC)
Source: "C:\Windows\System32\msvcp140.dll"; DestDir: "{app}"; Flags: ignoreversion skipifsourcedoesntexist
Source: "C:\Windows\System32\vcruntime140.dll"; DestDir: "{app}"; Flags: ignoreversion skipifsourcedoesntexist
Source: "C:\Windows\System32\vcruntime140_1.dll"; DestDir: "{app}"; Flags: ignoreversion skipifsourcedoesntexist
Source: "C:\Windows\System32\msvcp140_1.dll"; DestDir: "{app}"; Flags: ignoreversion skipifsourcedoesntexist
Source: "C:\Windows\System32\msvcp140_2.dll"; DestDir: "{app}"; Flags: ignoreversion skipifsourcedoesntexist
Source: "C:\Windows\System32\vccorlib140.dll"; DestDir: "{app}"; Flags: ignoreversion skipifsourcedoesntexist

; Environment config & CSV templates
Source: ".env"; DestDir: "{app}"; Flags: ignoreversion skipifsourcedoesntexist
Source: "bulk_booking_template.csv"; DestDir: "{app}"; Flags: ignoreversion skipifsourcedoesntexist

; App Icon for shortcuts
Source: "windows\runner\resources\app_icon.ico"; DestDir: "{app}"; Flags: ignoreversion

; Node.js WhatsApp Engine
Source: "whatsapp_engine\*"; DestDir: "{app}\whatsapp_engine"; Flags: ignoreversion recursesubdirs createallsubdirs; Excludes: "whatsapp_session\*,app_session\*,*.log,node_modules\.cache\*,scratch_*"

; Python Scripts (PDF Sambad Parser)
Source: "scripts\*"; DestDir: "{app}\scripts"; Flags: ignoreversion recursesubdirs createallsubdirs skipifsourcedoesntexist

; Background Engine Launcher Scripts
Source: "start_whatsapp_server.bat"; DestDir: "{app}"; Flags: ignoreversion
Source: "start_whatsapp_server_silent.vbs"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; WorkingDir: "{app}"; IconFilename: "{app}\app_icon.ico"
Name: "{group}\Start WhatsApp Engine Server"; Filename: "{app}\start_whatsapp_server.bat"; WorkingDir: "{app}"; IconFilename: "{app}\app_icon.ico"
Name: "{group}\{cm:UninstallProgram,{#MyAppName}}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; WorkingDir: "{app}"; Tasks: desktopicon; IconFilename: "{app}\app_icon.ico"
Name: "{autodesktop}\Start WhatsApp Engine"; Filename: "{app}\start_whatsapp_server.bat"; WorkingDir: "{app}"; Tasks: desktopicon; IconFilename: "{app}\app_icon.ico"
Name: "{userstartup}\OpsCore Pro WhatsApp Server"; Filename: "{app}\start_whatsapp_server_silent.vbs"; WorkingDir: "{app}"

[Dirs]
Name: "{app}"; Permissions: users-full
Name: "{app}\whatsapp_engine"; Permissions: users-full
Name: "{commonappdata}\OpsCore_Pro"; Permissions: users-full
Name: "C:\Lottery_Reports"; Permissions: users-full

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent
